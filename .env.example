# Copy to .env.development.local (gitignored) to point local dev at a self-hosted
# PeerServer. `bun run dev:mesh` sets these for you; production builds leave them
# unset and keep using PeerJS Cloud. See ops/PEERJS.md.

# Local PeerServer started by `bun run peer:server`
# VITE_PEERJS_HOST=127.0.0.1
# VITE_PEERJS_PORT=9000
# VITE_PEERJS_SECURE=false
# VITE_PEERJS_PATH=/
# VITE_PEERJS_LABEL=Local PeerServer

# Or an ordered list (first healthy wins; PeerJS Cloud is always appended last)
# VITE_PEERJS_ENDPOINTS='[{"id":"local","label":"Local PeerServer","host":"127.0.0.1","port":9000,"secure":false,"path":"/"}]'

# Optional
# VITE_PEERJS_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
# VITE_PEERJS_ATTEMPTS_PER_ENDPOINT=3
